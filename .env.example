# ==========================================
# Quant Alpha MLOps - Environment Variables
# ==========================================
# Copy this file to .env and replace placeholders with your actual API credentials.
# NEVER commit .env to version control.

# Cloud GPU & Remote Execution (Modal)
MODAL_API_TOKEN=YOUR_MODAL_API_TOKEN

# Experiment Tracking & MLOps (Weights & Biases)
WANDB_API_KEY=YOUR_WANDB_API_KEY

# Brokerage & Paper Execution (Alpaca)
ALPACA_API_KEY=YOUR_ALPACA_API_KEY
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_KEY

# Alternative Data Providers & Ingestion Services
MASSIVE_API_KEY=YOUR_MASSIVE_API_KEY
DATABENTO_API_KEY=YOUR_DATABENTO_API_KEY
OPENFIGI_API_KEY=YOUR_OPENFIGI_API_KEY
TIINGO_API_KEY=YOUR_TIINGO_API_KEY
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY